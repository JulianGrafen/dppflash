# Gefahrstoff-QR — Umgebungsvariablen
# Kopiere diese Datei als .env.local und fülle die Werte aus.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Nur serverseitig — niemals an den Browser ausliefern!
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# FAQ-Assistent (optional KI-API) — nicht ins Frontend, nicht committen
# Lokal: workers/faq-chat/.dev.vars oder Env beim Start von npm run faq-chat:server

# Option A: OpenAI.com
OPENAI_API_KEY=
# FAQ_LLM_DEPLOYMENT=gpt-4o-mini

# Option B: Microsoft Foundry (Projekt-Endpoint + Deployment-Name)
# AZURE_FOUNDRY_PROJECT_ENDPOINT=https://dpp-faq-bot.services.ai.azure.com/api/projects/proj-default
# AZURE_OPENAI_API_KEY=<Key aus Foundry / Azure OpenAI>
# FAQ_LLM_DEPLOYMENT=gpt-5.4-nano
