f:T576,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Welche Textilprodukte sind von der ESPR betroffen?","acceptedAnswer":{"@type":"Answer","text":"Die ESPR erfasst ab 2027 Bekleidung, Heimtextilien und technische Textilien, die auf dem EU-Markt vermarktet werden. Hersteller und Importeure sind gleichermaßen verpflichtet, einen Digitalen Produktpass bereitzustellen."}},{"@type":"Question","name":"Was muss der Digitale Produktpass für Textilien enthalten?","acceptedAnswer":{"@type":"Answer","text":"Pflichtfelder sind Materialzusammensetzung, Herkunftsland, Reparierbarkeitsindex, Recyclingfähigkeit sowie Informationen zu gefährlichen Stoffen. Die Daten müssen maschinenlesbar (JSON-LD, GS1) vorliegen."}},{"@type":"Question","name":"Welche Strafen drohen Textilherstellern ohne DPP?","acceptedAnswer":{"@type":"Answer","text":"Produkte ohne gültigen Digitalen Produktpass gelten als nicht konform. Es drohen EU-weite Verkaufsverbote, Zollbeschlagnahmungen und Bußgelder, die laut ESPR-Rahmen bis zu 4 % des jährlichen EU-Umsatzes betragen können."}},{"@type":"Question","name":"Wie lange muss der DPP für Textilien archiviert werden?","acceptedAnswer":{"@type":"Answer","text":"Die ESPR schreibt eine Mindestaufbewahrungspflicht von 15 Jahren vor. Die Daten müssen revisionssicher, jederzeit abrufbar und interoperabel gespeichert sein."}}]}4:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://dppflash.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Branchen & Regulierung\",\"item\":\"https://dppflash.de/branchen\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"ESPR 2027: Was Textilhersteller jetzt vorbereiten müssen\",\"item\":\"https://dppflash.de/branchen/textilindustrie-espr-verordnung-2027\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"ESPR 2027: Was Textilhersteller jetzt vorbereiten müssen\",\"description\":\"Die ESPR-Verordnung trifft die Textilindustrie ab 2027 mit verbindlichen Nachweispflichten. Hersteller und Importeure müssen einen Digitalen Produktpass bereitstellen – sonst drohen Verkaufsverbote und Bußgelder bis zu 4 % des Jahresumsatzes.\",\"datePublished\":\"2026-04-05\",\"dateModified\":\"2026-04-05\",\"author\":{\"@type\":\"Organization\",\"name\":\"DPP-Flash\",\"url\":\"https://dppflash.de\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"DPP-Flash\",\"url\":\"https://dppflash.de\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://dppflash.de/branchen/textilindustrie-espr-verordnung-2027\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$f"}}],["$","main",null,{"children":[["$","article",null,{"children":[["$","header",null,{"children":[["$","h1",null,{"children":"ESPR 2027: Was Textilhersteller jetzt vorbereiten müssen"}],["$","p",null,{"children":"Die ESPR-Verordnung trifft die Textilindustrie ab 2027 mit verbindlichen Nachweispflichten. Hersteller und Importeure müssen einen Digitalen Produktpass bereitstellen – sonst drohen Verkaufsverbote und Bußgelder bis zu 4 % des Jahresumsatzes."}]]}],["$","section",null,{"aria-labelledby":"context-heading","children":[["$","h2",null,{"id":"context-heading","children":"Was das für Ihr Unternehmen bedeutet"}],"$L10"]}],"$L11","$L12"]}],"$L13"]}]]
