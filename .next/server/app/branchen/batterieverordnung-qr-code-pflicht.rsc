4:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://dppflash.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Branchen & Regulierung\",\"item\":\"https://dppflash.de/branchen\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"EU-Batterieverordnung: QR-Code-Pflicht für Hersteller ab 2027\",\"item\":\"https://dppflash.de/branchen/batterieverordnung-qr-code-pflicht\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"EU-Batterieverordnung: QR-Code-Pflicht für Hersteller ab 2027\",\"description\":\"Die EU-Batterieverordnung verpflichtet Batteriehersteller und -importeure ab August 2026, einen digitalen Batteriepass mit QR-Code bereitzustellen. Wer die Frist verpasst, riskiert Marktzugangssperren in der gesamten EU.\",\"datePublished\":\"2027-04-05\",\"dateModified\":\"2026-04-05\",\"author\":{\"@type\":\"Organization\",\"name\":\"DPP-Flash\",\"url\":\"https://dppflash.de\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"DPP-Flash\",\"url\":\"https://dppflash.de\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://dppflash.de/branchen/batterieverordnung-qr-code-pflicht\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Welche Batterien brauchen ab 2027 einen QR-Code?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Industriebatterien ab 2 kWh, Traktionsbatterien für E-Fahrzeuge und Starterbatterien ab August 2027. Ab 2027 wird die Pflicht auf weitere Kategorien ausgeweitet.\"}},{\"@type\":\"Question\",\"name\":\"Was muss der Batteriepass-QR-Code enthalten?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Der QR-Code muss auf einen Datensatz mit Herstellerangaben, Batteriechemie, Kapazität, Lebensdauer, Carbon Footprint und Recyclinginformationen verweisen. Das Format muss maschinenlesbar und interoperabel sein.\"}},{\"@type\":\"Question\",\"name\":\"Bin ich als Importeur auch verpflichtet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ja. Alle Unternehmen, die Batterien unter eigenem Namen in der EU vermarkten oder importieren, tragen die Verantwortung für die Bereitstellung eines konformen Batteriepasses.\"}}]}"}}],["$","main",null,{"children":[["$","article",null,{"children":[["$","header",null,{"children":[["$","h1",null,{"children":"EU-Batterieverordnung: QR-Code-Pflicht für Hersteller ab 2027"}],["$","p",null,{"children":"Die EU-Batterieverordnung verpflichtet Batteriehersteller und -importeure ab August 2026, einen digitalen Batteriepass mit QR-Code bereitzustellen. Wer die Frist verpasst, riskiert Marktzugangssperren in der gesamten EU."}]]}],["$","section",null,{"aria-labelledby":"context-heading","children":[["$","h2",null,{"id":"context-heading","children":"Was das für Ihr Unternehmen bedeutet"}],["$","p",null,{"children":"Der QR-Code muss auf einen maschinenlesbaren Datensatz mit Kapazität, Chemie, Carbon Footprint und Recyclinganteil verweisen. DPP-Flash extrahiert diese Daten automatisch aus bestehenden Lieferscheinen und Technischen Datenblättern und erzeugt den konformen Batteriepass-QR-Code."}]]}],["$","section",null,{"aria-labelledby":"faq-heading","children":[["$","h2",null,{"id":"faq-heading","children":"Häufige Fragen"}],[["$","details","Welche Batterien brauchen ab 2027 einen QR-Code?",{"children":["$Lf","$L10"]}],"$L11","$L12"]]}],"$L13"]}],"$L14"]}]]
