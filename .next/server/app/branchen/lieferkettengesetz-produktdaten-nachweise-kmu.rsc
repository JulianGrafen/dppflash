f:T42c,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Wen betrifft das Lieferkettensorgfaltspflichtengesetz?","acceptedAnswer":{"@type":"Answer","text":"Seit 2024 gilt das LkSG für alle Unternehmen mit mehr als 1.000 Mitarbeitenden in Deutschland. Indirekt sind aber auch KMU als Zulieferer großer Unternehmen betroffen, da Abnehmer Nachweise entlang der Kette einfordern."}},{"@type":"Question","name":"Welche Daten müssen für LkSG & ESPR dokumentiert werden?","acceptedAnswer":{"@type":"Answer","text":"Rohstoffherkunft, Produktionsbedingungen, Gefahrstoffangaben (SVHC), Nachhaltigkeitszertifikate und Konformitätserklärungen müssen digital, maschinenlesbar und revisionssicher vorliegen."}},{"@type":"Question","name":"Reicht eine Excel-Tabelle für LkSG-Nachweise?","acceptedAnswer":{"@type":"Answer","text":"Nein. Behörden und Prüfer erwarten maschinenlesbare, interoperable Formate wie JSON-LD oder GS1-konformes XML, die eine revisionssichere Langzeitarchivierung und automatische Prüfbarkeit ermöglichen."}}]}4:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://dppflash.de/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Branchen & Regulierung\",\"item\":\"https://dppflash.de/branchen\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"LkSG & ESPR: Welche Produktdaten-Nachweise KMU brauchen\",\"item\":\"https://dppflash.de/branchen/lieferkettengesetz-produktdaten-nachweise-kmu\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"LkSG & ESPR: Welche Produktdaten-Nachweise KMU brauchen\",\"description\":\"Das Lieferkettensorgfaltspflichtengesetz (LkSG) und die ESPR fordern von KMU lückenlose Produktdaten-Nachweise entlang der gesamten Lieferkette. Excel-Tabellen reichen nicht mehr aus – interoperable digitale Nachweise sind Pflicht.\",\"datePublished\":\"2026-04-05\",\"dateModified\":\"2026-04-05\",\"author\":{\"@type\":\"Organization\",\"name\":\"DPP-Flash\",\"url\":\"https://dppflash.de\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"DPP-Flash\",\"url\":\"https://dppflash.de\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://dppflash.de/branchen/lieferkettengesetz-produktdaten-nachweise-kmu\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$f"}}],["$","main",null,{"children":[["$","article",null,{"children":[["$","header",null,{"children":[["$","h1",null,{"children":"LkSG & ESPR: Welche Produktdaten-Nachweise KMU brauchen"}],["$","p",null,{"children":"Das Lieferkettensorgfaltspflichtengesetz (LkSG) und die ESPR fordern von KMU lückenlose Produktdaten-Nachweise entlang der gesamten Lieferkette. Excel-Tabellen reichen nicht mehr aus – interoperable digitale Nachweise sind Pflicht."}]]}],["$","section",null,{"aria-labelledby":"context-heading","children":[["$","h2",null,{"id":"context-heading","children":"Was das für Ihr Unternehmen bedeutet"}],["$","p",null,{"children":"Unternehmen müssen nachweisen können, woher Rohstoffe stammen, welche Stoffe enthalten sind und wie die Produktion erfolgte. DPP-Flash digitalisiert und validiert diese Nachweisdaten aus bestehenden Dokumenten und stellt sie revisionssicher für Audits zur Verfügung."}]]}],["$","section",null,{"aria-labelledby":"faq-heading","children":["$L10",["$L11","$L12","$L13"]]}],"$L14"]}],"$L15"]}]]
